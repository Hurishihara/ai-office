{
  "name": "ai-office",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @ai-office/server",
    "dev:client": "npm run dev -w @ai-office/client",
    "reindex": "tsx --env-file-if-exists=.env server/scripts/reindex.ts",
    "lint": "npm run lint -w @ai-office/server",
    "test": "npm test -w @ai-office/server && npm test -w @ai-office/client"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
